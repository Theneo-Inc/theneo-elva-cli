{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Elva agent artifact v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "audience": {
      "enum": [
        "partner",
        "public",
        "internal"
      ]
    },
    "auth": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "bearer",
            "api_key",
            "none"
          ]
        },
        "header": {
          "type": "string",
          "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
          "maxLength": 100
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "api_key"
              }
            }
          },
          "then": {
            "required": [
              "header"
            ]
          },
          "else": {
            "not": {
              "required": [
                "header"
              ]
            }
          }
        }
      ]
    },
    "spec": {
      "$ref": "#/definitions/spec"
    }
  },
  "required": [
    "version",
    "requestId",
    "name",
    "audience",
    "auth",
    "spec"
  ],
  "additionalProperties": false,
  "definitions": {
    "schema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "format": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "pattern": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "$ref": {
          "type": "string",
          "pattern": "^#/components/schemas/[^/]+$",
          "maxLength": 250
        },
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/schema"
          },
          "maxProperties": 500
        },
        "items": {
          "$ref": "#/definitions/schema"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 400
        },
        "enum": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/definitions/schema"
            }
          ]
        },
        "allOf": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/schema"
          },
          "maxItems": 30
        },
        "anyOf": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/schema"
          },
          "maxItems": 30
        },
        "oneOf": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/schema"
          },
          "maxItems": 30
        },
        "not": {
          "$ref": "#/definitions/schema"
        },
        "nullable": {
          "type": "boolean"
        },
        "readOnly": {
          "type": "boolean"
        },
        "writeOnly": {
          "type": "boolean"
        },
        "deprecated": {
          "type": "boolean"
        },
        "uniqueItems": {
          "type": "boolean"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "multipleOf": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "exclusiveMaximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "minProperties": {
          "type": "integer",
          "minimum": 0
        },
        "maxProperties": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/definitions/schema"
        }
      },
      "required": [
        "schema"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/media"
      },
      "maxProperties": 8
    },
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "in": {
          "enum": [
            "path",
            "query",
            "header",
            "cookie"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "$ref": "#/definitions/schema"
        },
        "style": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50
        },
        "explode": {
          "type": "boolean"
        },
        "allowReserved": {
          "type": "boolean"
        },
        "deprecated": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "in",
        "schema"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "content": {
          "$ref": "#/definitions/content"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 0,
                "maxLength": 1000
              },
              "schema": {
                "$ref": "#/definitions/schema"
              }
            },
            "required": [
              "schema"
            ],
            "additionalProperties": false
          },
          "maxProperties": 40
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "responses": {
      "type": "object",
      "patternProperties": {
        "^([1-5][0-9]{2}|default)$": {
          "$ref": "#/definitions/response"
        }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 30
    },
    "operation": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 100
          },
          "maxItems": 10
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/parameter"
          },
          "maxItems": 80
        },
        "requestBody": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            },
            "required": {
              "type": "boolean"
            },
            "content": {
              "$ref": "#/definitions/content"
            }
          },
          "required": [
            "content"
          ],
          "additionalProperties": false
        },
        "responses": {
          "$ref": "#/definitions/responses"
        },
        "deprecated": {
          "type": "boolean"
        }
      },
      "required": [
        "responses"
      ],
      "additionalProperties": false
    },
    "pathItem": {
      "type": "object",
      "properties": {
        "get": {
          "$ref": "#/definitions/operation"
        },
        "post": {
          "$ref": "#/definitions/operation"
        },
        "put": {
          "$ref": "#/definitions/operation"
        },
        "patch": {
          "$ref": "#/definitions/operation"
        },
        "delete": {
          "$ref": "#/definitions/operation"
        },
        "head": {
          "$ref": "#/definitions/operation"
        },
        "options": {
          "$ref": "#/definitions/operation"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/parameter"
          },
          "maxItems": 80
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "openapi": {
          "type": "string",
          "pattern": "^3\\.(0|1)\\.[0-9]+$"
        },
        "info": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "description": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            }
          },
          "required": [
            "title",
            "version"
          ],
          "additionalProperties": false
        },
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1
        },
        "paths": {
          "type": "object",
          "patternProperties": {
            "^/": {
              "$ref": "#/definitions/pathItem"
            }
          },
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 400
        },
        "components": {
          "type": "object",
          "properties": {
            "schemas": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/schema"
              },
              "maxProperties": 1000
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "openapi",
        "info",
        "servers",
        "paths"
      ],
      "additionalProperties": false
    }
  }
}
